# Sao chép thành .env khi cần cấu hình môi trường.
# Không commit file .env thật lên GitHub.
# Local development; Compose overrides cookies/origin/runtime/Ollama URL.
DATA_DIR=runtime
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

ENABLE_VECTORS=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Empty means local Qdrant, one process only. Protect any remote server.
QDRANT_URL=
QDRANT_API_KEY=

# none | ollama | openai. Install Ollama/model in a separate explicit step.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
LLM_NUM_GPU=0
LLM_TIMEOUT=60
OLLAMA_URL=http://127.0.0.1:11434
# Approved OpenAI-compatible HTTPS base ending in /v1 and its key.
LLM_BASE_URL=
LLM_API_KEY=

# Actual DNS hostname, no scheme/path; blank prevents accidental deployment.
SITE_DOMAIN=
LIBRARY_IMAGE=uth-library:local

# Collection stays off until authorized seeds and an interval >= 1 exist.
CRAWL_ALLOWED_HOSTS=lic.ut.edu.vn,opacthuvien.ut.edu.vn
CRAWL_SEEDS=
CRAWL_INTERVAL_HOURS=0

# Approved library bridge only; see docs/integrations.md.
LIBRARY_LOANS_URL=
LIBRARY_RENEW_URL=

# Channels remain unavailable without all credentials and permissions.
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_GRAPH_VERSION=
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_ID=
ZALO_ACCESS_TOKEN=
